{
	"app-nas/freedomnas": {"type": "release", "repo": "FreedomNAS/freedomnas-core"},
	"app-nas/freedomnas-core": {"type": "release", "repo": "FreedomNAS/freedomnas-core"},
	"app-nas/freedomnas-profiles": {"type": "release", "repo": "FreedomNAS/freedomnas-profiles"},
	"app-nas/freedomnas-webui": {"type": "release", "repo": "FreedomNAS/freedomnas-webui"},
	"app-nas/freedomnas-installer": {"type": "release", "repo": "FreedomNAS/freedomnas-installer"},
	"app-nas/freedomnas-docs": {"type": "release", "repo": "FreedomNAS/freedomnas-docs"},
	"app-nas/freedomnas-module-containers": {"type": "release", "repo": "FreedomNAS/freedomnas-containers"},
	"app-nas/freedomnas-module-proxy": {"type": "release", "repo": "FreedomNAS/freedomnas-proxy"},
	"app-admin/topgrade-bin": {"type": "github-release", "repo": "topgrade-rs/topgrade"},
	"app-crypt/archlinux-keyring": {
		"type": "listing",
		"url": "https://geo.mirror.pkgbuild.com/core/os/x86_64/",
		"pattern": "archlinux-keyring-([0-9]+)-1-any\\.pkg\\.tar\\.zst"
	},
	"app-crypt/artix-keyring": {
		"type": "listing",
		"urls": [
			"https://mirror1.artixlinux.org/repos/system/os/x86_64/",
			"https://mirrors.dotsrc.org/artix-linux/repos/system/os/x86_64/",
			"https://mirror.clarkson.edu/artix-linux/repos/system/os/x86_64/"
		],
		"pattern": "artix-keyring-([0-9]+)-1-any\\.pkg\\.tar\\.zst"
	},
	"sys-apps/arch-install-scripts": {
		"type": "git-tag",
		"url": "https://gitlab.archlinux.org/archlinux/arch-install-scripts.git",
		"prepare": true
	},
	"dev-python/zensical": {
		"type": "pypi",
		"project": "zensical",
		"prepare": true,
		"pins": {"zensical-ui": "dev-python/zensical-ui"},
		"cargo": {
			"url": "https://files.pythonhosted.org/packages/source/z/zensical/zensical-{ver}.tar.gz",
			"dir": "zensical-{ver}/crates/zensical"
		}
	}
}
